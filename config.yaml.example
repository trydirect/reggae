default_provider: porkbun

providers:
  porkbun:
    api_key: ""
    secret_api_key: ""
  # Cloudflare token permissions:
  #   DNS only:           Zone/Zone/Read + Zone/DNS/Edit
  #   DNS + Registrar:    Zone/Zone/Edit + Zone/DNS/Edit + Account/Registrar/Edit
  # account_id is required for Registrar API (register, renew, transfer).
  # Found in the right sidebar of the Cloudflare dashboard.
  cloudflare:
    api_token: ""
    account_id: ""
  godaddy:
    api_key: ""
    api_secret: ""
    sandbox: false
    consent_ip: ""
  namecheap:
    api_user: ""
    api_key: ""
    username: ""
    client_ip: ""
    sandbox: false
  # Gandi uses Personal Access Tokens (PAT) created at https://account.gandi.net
  # DNS is managed via the LiveDNS sub-API (zone-based, similar to Cloudflare).
  # Sandbox requires a separate account at https://id.sandbox.gandi.net
  gandi:
    personal_access_token: ""
    sandbox: false
  # Name.com API token created at https://www.name.com/account/settings/api
  # Use api.dev.name.com as the sandbox endpoint (separate test credentials).
  namecom:
    username: ""
    api_token: ""
    sandbox: false
  # Dynadot has two APIs: stable XML (api3.xml) and a REST JSON Beta.
  # api_secret is only required when use_rest_api is true.
  # Sandbox: api-sandbox.dynadot.com — zero-cost transactions, separate credentials.
  dynadot:
    api_key: ""
    api_secret: ""
    sandbox: false
    use_rest_api: false   # false = XML (stable), true = REST JSON (beta)
  # IONOS API key is prefix.secret — generate at https://developer.hosting.ionos.com/keys
  # Note: domain availability check is not officially supported by the IONOS API.
  ionos:
    api_prefix: ""
    api_secret: ""
  # Hetzner DNS API — DNS record management only (zone-based, like Cloudflare).
  # Domain registration is not available via any Hetzner REST API.
  # Token created at https://console.hetzner.com
  hetzner:
    api_token: ""

registrant:
  first_name: ""
  last_name: ""
  email: ""
  phone: ""
  address1: ""
  city: ""
  state: ""
  country: ""
  postal_code: ""

scheduler:
  enabled: false
  check_interval_secs: 86400   # daily
  expiry_lead_days: 30         # notify when < 30 days left
  domains: []                  # list of domains to monitor
  notification:
    type: stdout               # stdout | webhook
    webhook_url: ""

logging:
  level: info                  # trace | debug | info | warn | error
